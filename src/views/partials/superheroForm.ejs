<!-- Identidad -->
<fieldset>
    <legend>Identidad</legend>

    <div class="grid-2">
        <div class="field">
            <label for="nombreSuperheroe">Nombre de superhéroe *</label>
            <input type="text" id="nombreSuperheroe" name="nombreSuperheroe"
                placeholder="Ej. Spider-Man"
                value="<%= superheroe.nombreSuperheroe %>"
                required minlength="3" maxlength="60"/>
        </div>
        <div class="field">
            <label for="nombreReal">Nombre real *</label>
            <input type="text" id="nombreReal" name="nombreReal"
                placeholder="Ej. Peter Parker"
                value="<%= superheroe.nombreReal %>"
                required minlength="3" maxlength="60"/>
        </div>
    </div>

    <div class="grid-2">
        <div class="field">
            <label for="edad">Edad</label>
            <input type="number" id="edad" name="edad"
                placeholder="Ej. 17" min="0" step="0.1"
                value="<%= superheroe.edad %>"
                required/>
        </div>
        <div class="field">
            <label for="planetaOrigen">Planeta de origen</label>
            <input type="text" id="planetaOrigen" name="planetaOrigen"
                placeholder="Tierra"
                value="<%= superheroe.planetaOrigen %>"/>
        </div>
    </div>

    <div class="field">
        <label for="creador">Creador</label>
        <input type="text" id="creador" name="creador"
            placeholder="Ej. Stan Lee"
            value="<%= superheroe.creador %>"/>
    </div>
</fieldset>

<!-- Habilidades -->
<fieldset>
    <legend>Habilidades y debilidades</legend>

    <div class="field">
        <label for="debilidad">Debilidad</label>
        <input type="text" id="debilidad" name="debilidad"
            placeholder="Ej. Kryptonita"
            value="<%= superheroe.debilidad %>"/>
    </div>

    <div class="field">
        <label for="poderes">Poderes</label>
        <input type="text" id="poderes" name="poderes"
            placeholder="Ej. Vuelo, Superfuerza, Visión láser"
            value="<%= superheroe.poderes %>"
            required/>
        <small>Separa cada poder con una coma</small>
    </div>
</fieldset>

<!-- Relaciones -->
<fieldset>
    <legend>Relaciones</legend>

    <div class="field">
        <label for="aliados">Aliados</label>
        <input type="text" id="aliados" name="aliados"
            placeholder="Ej. Iron Man, Thor, Hulk"
            value="<%= superheroe.aliados %>"/>
        <small>Separa cada aliado con una coma</small>
    </div>

    <div class="field">
        <label for="enemigos">Enemigos</label>
        <input type="text" id="enemigos" name="enemigos"
            placeholder="Ej. Thanos, Loki"
            value="<%= superheroe.enemigos %>"/>
        <small>Separa cada enemigo con una coma</small>
    </div>
</fieldset>