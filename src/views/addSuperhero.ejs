<!DOCTYPE html>
<html lang="es" class="bg-neutral-950 text-neutral-100">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;600&display=swap"
        rel="stylesheet">

    <title>Nuevo Superhéroe</title>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        h1,
        h2 {
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 1px;
        }

        .form-container {
            max-width: 800px;
            margin: auto;
            background: #171717;
            border: 1px solid #262626;
            padding: 2rem;
            border-radius: 1rem;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.6);
        }

        .btn-primary {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            padding: 0.6rem 1.2rem;
            border-radius: 0.5rem;
            font-weight: 600;
            transition: 0.2s;
        }

        .btn-primary:hover {
            transform: scale(1.05);
            box-shadow: 0 0 10px rgba(37, 99, 235, 0.6);
        }

        .btn-secondary {
            background: #262626;
            padding: 0.6rem 1.2rem;
            border-radius: 0.5rem;
        }

        .btn-row {
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
            margin-top: 2rem;
        }

        .form-hint {
            color: #9ca3af;
            font-size: 0.85rem;
            margin-bottom: 1.5rem;
        }

        .req {
            color: #ef4444;
        }
    </style>
</head>

<body class="p-6">

    <div class="form-container">

        <h2 class="text-3xl text-blue-500 mb-2">Nuevo héroe</h2>
        <p class="form-hint">Campos obligatorios <span class="req">*</span></p>

        <form id="add-superhero-form" action="/api/heroes/agregar" method="POST" autocomplete="off">

            <%- include("partials/superheroForm.ejs", { superheroe: { nombreSuperheroe: '' , nombreReal: '' , edad: '' ,
                planetaOrigen: '' , creador: '' , debilidad: '' , poderes: '' , aliados: '' , enemigos: '' } }) %>

                <div class="btn-row">
                    <a href="/api/heroes" class="btn-secondary">Cancelar</a>
                    <button type="submit" class="btn-primary">Guardar</button>
                </div>

        </form>

    </div>

    <script>
        /* Validación de los campos requeridos en el cliente */
        document.addEventListener("DOMContentLoaded", () => {
            const form = document.querySelector("#add-superhero-form");
            form.addEventListener("submit", async (e) => {
                e.preventDefault();

                // Obtener valores de los campos del formuario 
                const nombreSuperheroe = document.querySelector('input[name="nombreSuperheroe"]').value.trim();
                const nombreReal = document.querySelector('input[name="nombreReal"]').value.trim();
                const edad = document.querySelector('input[name="edad"]').value;
                const planetaOrigen = document.querySelector('input[name="planetaOrigen"]').value.trim();
                const creador = document.querySelector('input[name="creador"]').value.trim();
                const debilidad = document.querySelector('input[name="debilidad"]').value.trim();
                const poderes = document.querySelector('input[name="poderes"]').value.split(",").map(item => item.trim());

                const aliados = document.querySelector('input[name="aliados"]').value.split(",").map(item => item.trim());
                const enemigos = document.querySelector('input[name="enemigos"]').value.split(",").map(item => item.trim());

                const errors = [];

                // Validar los campos necesarios 
                if (!nombreSuperheroe) {
                    errors.push("El nombre del superhéroe es requerido");
                } else if (nombreSuperheroe.length < 3) {
                    errors.push("El nombre del superhéroe debe tener almenos 3 caractéres");
                } else if (nombreSuperheroe.length > 60) {
                    errors.push("El nombre del superhéroe no puede superar los 60 caracteres");
                }

                if (!nombreReal) {
                    errors.push("El nombre real del superhéroe es requerido");
                } else if (nombreReal.length < 3) {
                    errors.push("El nombre real del superhéroe debe tener almenos 3 caractéres");
                } else if (nombreReal.length > 60) {
                    errors.push("El nombre real del superhéroe no puede superar los 60 caracteres");
                }

                if (!edad) {
                    errors.push("La edad del superhéroe es requerida");
                } else if (isNaN(edad)) {
                    errors.push("La edad debe ser un número");
                } else if (edad < 0) {
                    errors.push("La edad no puede ser negativa")
                }

                if (poderes.length < 1) {
                    errors.push("El campo poderes no puede quedar vacío");
                } else if (poderes.some(poder => typeof poder !== "string")) {
                    erros.push("Cada poder deber ser un texto");
                } else if (poderes.some(poder => poder.length < 3)) {
                    errors.push("Cada poder debe tener almenos 3 caracteres");
                } else if (poderes.some(poder => poder.length > 60)) {
                    errors.push("Ningún poder puede superar los 60 caracteres");
                }

                // Si hubo errores de validación mostrar los errores con un alert
                if (errors.length > 0) {
                    alert(errors.join("\n"));
                    return;
                }

                // Crear objeto superheroe
                const superheroData = {
                    nombreSuperheroe,
                    nombreReal,
                    edad,
                    planetaOrigen: planetaOrigen ? planetaOrigen : "Desconocido",
                    debilidad: debilidad ? debilidad : "No especificada",
                    poderes,
                    aliados: aliados ? aliados : [],
                    enemigos: enemigos ? enemigos : [],
                    creador: creador ? creador : "Desconocido"
                };

                try {
                    const response = await fetch("/api/heroes/agregar", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(superheroData)
                    });

                    if (response.ok) {
                        const result = await response.json();
                        console.log(result);
                        window.location.href = result.redirectTo;
                    } else {
                        const result = await response.json()
                        alert("Error al agregar el superhéroe", error.message);
                        console.log(error)
                    }
                } catch {
                    const error = await response.json();
                    console.erorr("Error en la solicitud", error.message);
                    alert("Ocurrió un error inesperado");
                }

            })
        })
    </script>
</body>

</html>