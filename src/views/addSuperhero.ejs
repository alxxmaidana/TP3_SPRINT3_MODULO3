<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agregar nuevo Superhéroe</title>

    <style>
        body {
            background-color: #1F1F1E;
            color: whitesmoke;
        }
    </style>
</head>

<body>
    <div class="form-container">
        <h2>Nuevo superhéroe</h2>
        <p class="form-hint">Los campos con <span class="req">*</span> son obligatorios</p>

        <form action="/api/heroes/agregar" method="POST" autocomplete="off">
            <%- include("partials/superheroForm.ejs", { superheroe: { nombreSuperheroe: '' , nombreReal: '' , edad: '' ,
                planetaOrigen: '' , creador: '' , debilidad: '' , poderes: '' , aliados: '' , enemigos: '' } }) %>
                <div class="btn-row">
                    <a href="/api/heroes?_method=GET" class="btn-secondary">Cancelar</a>
                    <button type="submit" class="btn-primary">Guardar</button>
                </div>
        </form>

    </div>
</body>

</html>