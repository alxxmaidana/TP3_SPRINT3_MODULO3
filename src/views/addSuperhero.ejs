<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agregar nuevo Superhéroe</title>
</head>

<body>
    <div class="form-container">
        <h2>Nuevo superhéroe</h2>
        <p class="form-hint">Los campos con <span class="req">*</span> son obligatorios</p>

        <form action="/api/heroes/agregar" method="POST">

            <!-- Identidad -->
            <fieldset>
                <legend>Identidad</legend>

                <div class="grid-2">
                    <div class="field">
                        <label for="nombreSuperheroe">Nombre de superhéroe *</label>
                        <input type="text" id="nombreSuperheroe" name="nombreSuperheroe" placeholder="Ej. Spider-Man"
                            required />
                    </div>
                    <div class="field">
                        <label for="nombreReal">Nombre real *</label>
                        <input type="text" id="nombreReal" name="nombreReal" placeholder="Ej. Peter Parker" required />
                    </div>
                </div>

                <div class="grid-2">
                    <div class="field">
                        <label for="edad">Edad</label>
                        <input type="number" id="edad" name="edad" placeholder="Ej. 17" min="0" />
                    </div>
                    <div class="field">
                        <label for="planetaOrigen">Planeta de origen</label>
                        <input type="text" id="planetaOrigen" name="planetaOrigen" placeholder="Tierra" />
                        <small>Por defecto: Desconocido</small>
                    </div>
                </div>

                <div class="field">
                    <label for="creador">Creador</label>
                    <input type="text" id="creador" name="creador" placeholder="Ej. Stan Lee" />
                </div>
            </fieldset>

            <!-- Habilidades -->
            <fieldset>
                <legend>Habilidades y debilidades</legend>

                <div class="field">
                    <label for="debilidad">Debilidad</label>
                    <input type="text" id="debilidad" name="debilidad" placeholder="Ej. Kryptonita" />
                </div>

                <div class="field">
                    <label for="poderes">Poderes</label>
                    <input type="text" id="poderes" name="poderes" placeholder="Ej. Vuelo, Superfuerza, Visión láser" />
                    <small>Separa cada poder con una coma</small>
                </div>
            </fieldset>

            <!-- Relaciones -->
            <fieldset>
                <legend>Relaciones</legend>

                <div class="field">
                    <label for="aliados">Aliados</label>
                    <input type="text" id="aliados" name="aliados" placeholder="Ej. Iron Man, Thor, Hulk" />
                    <small>Separa cada aliado con una coma</small>
                </div>

                <div class="field">
                    <label for="enemigos">Enemigos</label>
                    <input type="text" id="enemigos" name="enemigos" placeholder="Ej. Thanos, Loki" />
                    <small>Separa cada enemigo con una coma</small>
                </div>
            </fieldset>

            <div class="btn-row">
                <a href="/api/heroes" class="btn-secondary">Cancelar</a>
                <button type="submit" class="btn-primary">Guardar superhéroe</button>
            </div>

        </form>
    </div>
</body>

</html>