<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de superhéroes</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --clr-background: #1F1F1E;
            --clr-text: #F4F3EF;
            --clr-card: #30302E;
            --border-color: #4A4A46;
            --line-clr: #4A4A46;
        }

        body {
            background-color: var(--clr-background);
            color: var(--clr-text);
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.5rem;
            padding: 1rem;
        }

        .superhero-card {
            background-color: var(--clr-card);
            border: 1px solid var(--border-color);
            padding: 1rem;
            border-radius: 10px;
        }

        .card__header {
            border-bottom: 1px solid var(--border-color);
            padding: 1rem 0;
            display: flex;
        }

        .header__avatar {
            border-radius: 50%;
            width: 50px;
            height: 50px;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #253E5F;
            color: #7CA5D8;
        }

        .header__title {
            
        }
    </style>
</head>
<body>
    <header class="dashboard-header">
        <h1>Trabajo Práctico Nro 3 - Sprint 3</h1>
    </header>

    <form action="/api/heroes/agregar" method="GET">
        <button type="submit" class="btn-primary">+ Agregar superhéroe</button>
    </form>

    <div class="cards-grid">
        <% superheroes.forEach(heroe=> { %>
            <%- include("./partials/superhero-cards.ejs", { heroe }) %>
        <% }); %>
    </div>
</body>

</html>