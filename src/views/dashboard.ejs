<!DOCTYPE html>
<html lang="es" class="bg-neutral-950 text-neutral-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Tailwind -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

    <title>Superhéroes</title>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        h1, h2, h3 {
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 1px;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 2rem;
        }

        .btn-primary {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            padding: 0.6rem 1.2rem;
            border-radius: 0.5rem;
            font-weight: 600;
            transition: 0.2s;
        }

        .btn-primary:hover {
            transform: scale(1.05);
            box-shadow: 0 0 10px rgba(37,99,235,0.7);
        }
    </style>
</head>

<body class="px-6 py-8">

    <header class="mb-10 flex justify-between items-center border-b border-neutral-800 pb-4 w-[80%] mx-auto">
        <div>
            <h1 class="text-4xl text-blue-500">TP 3 - Sprint 3</h1>
            <p class="text-neutral-400 text-sm">Métodos CRUD con colección de Superhéroes</p>
        </div>

        <a href="/api/heroes/agregar" type="submit" class="btn-primary">
            + Nuevo héroe
        </a>
    </header>

    <div class="cards-grid w-[80%] mx-auto">

        <% superheroes.forEach(heroe => { %>
            <%- include("./partials/superheroCards.ejs", { heroe }) %>
        <% }); %>

    </div>

    <script>
        async function eliminarSuperheroe(id) {
            const confirmar = confirm("¿Está suguro de eliminar este superhéroe? Esta acción no se puede deshacer.");

            if (confirmar) {
                try {
                    const response = await fetch(`/api/heroes/${id}`, { method: "DELETE" })

                    if (response.ok) {
                        window.location.reload();
                    }
                } catch {
                    const error = await response.json();
                    alert("Ocurrió un error inesperado.");
                    console.error("Error al eliminar el superhéroe", error.message);
                }
            }
        }
    </script>
</body>